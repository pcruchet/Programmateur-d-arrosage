        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_ecrireMode" name="ecrireMode"         visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_lireMode"   name="lireMode"           visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_reinit"     name="reinitialiserVanne" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_reinitAll"  name="reinitialiserTout"  visibility="public"/>
      </packagedElement>

      <!-- ═══════════════════════════════════════════
