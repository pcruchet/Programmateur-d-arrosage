        <ownedOperation xmi:type="uml:Operation" xmi:id="gt_calculerOcc"    name="calculerOccurrenceCourante" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="gt_calcProch"      name="calculerProchaineAlarme"    visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="gt_ajouterMin"     name="ajouterMinutes"         visibility="public"/>
      </packagedElement>

      <!-- ═══════════════════════════════════════════
