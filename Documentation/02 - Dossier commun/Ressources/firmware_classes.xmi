      <packagedElement xmi:type="uml:Class" xmi:id="cls_stockprog" name="StockageProgrammationVannes">
        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_init"      name="initialiser"        visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="sp_ecrire"    name="ecrireProgrammation" visibility="public"/>
