        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="oled_ip"     name="adresseIP"      visibility="private">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="oled_client" name="clientConnecte"  visibility="private">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Boolean"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="oled_heure"  name="heureSysteme"   visibility="private">
          <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
        </ownedAttribute>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_init"         name="initialiser"      visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_setMode"      name="setModeWifi"      visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_setIP"        name="setAdresseIP"     visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_setClient"    name="setClientConnecte" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_setEtatV"     name="setEtatVannes"    visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_setHeure"     name="setHeureSysteme"  visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_rafraichir"   name="rafraichir"       visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_eteindre"     name="eteindre"         visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="oled_allumer"      name="allumer"          visibility="public"/>
      </packagedElement>

      <!-- ═══════════════════════════════════════════
           Classe GestionnaireTemps
      ═══════════════════════════════════════════ -->
      <packagedElement xmi:type="uml:Class" xmi:id="cls_temps" name="GestionnaireTemps">
        <ownedAttribute xmi:type="uml:Property" xmi:id="gt_broche" name="brocheIRQ" visibility="private">
