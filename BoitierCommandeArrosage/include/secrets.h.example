#ifndef SECRETS_H
#define SECRETS_H

/**
 * @file    secrets.h.example
 * @brief   Modèle du fichier secrets.h (identifiants Wi-Fi).
 *
 * @details Copier ce fichier en secrets.h (dossier include/, ignoré par
 *          git) et renseigner vos propres identifiants avant de compiler.
 */

// --- Wi-Fi STA (réseau domestique auquel l'ESP32 doit se connecter) ---
#define SSID_STA     "VotreSSID"
#define PASSWORD_STA "VotreMotDePasse"

// --- Wi-Fi AP (point d'accès de secours diffusé par le boîtier) ---
#define SSID_AP      "ArrosageAP"
#define PASSWORD_AP  "changez-moi"

#endif // SECRETS_H
